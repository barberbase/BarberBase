# Database
DATABASE_URL=             # postgres://bb_user:${DB_PASSWORD}@postgres:5432/barberbase

# Security
JWT_SECRET=               # 32+ byte random — staff JWT signing
HMAC_SECRET=              # 32+ byte random — magic link token + state token signing
AES_ENCRYPTION_KEY=       # Exactly 32 bytes — AES-256-GCM for bhejna_api_key_encrypted
PLATFORM_ADMIN_KEY=       # 32+ byte random — gates POST /admin/setup (operator provisioning only, never shared with shops)

# Bhejna — Mode A (shared platform number)
BHEJNA_API_URL=           # https://bhejna-api.codenxtlab.tech
BHEJNA_API_KEY=           # api_key from BarberBase's Bhejna portal account
BHEJNA_WEBHOOK_SECRET=     # webhook_secret set in Bhejna portal (HMAC-SHA256 verification)
BHEJNA_FROM_PHONE=         # BarberBase platform phone, e.g. +912212345678

# Web Push (VAPID) — Staff PWA
# Generate once: webpush.GenerateVAPIDKeys() — never rotate without re-subscribing all clients
VAPID_PUBLIC_KEY=      # base64url EC P-256 public key; also set as PUBLIC_VAPID_PUBLIC_KEY in Cloudflare Pages
VAPID_PRIVATE_KEY=     # base64url EC P-256 private key; NEVER sent to client; NEVER logged
VAPID_SUBJECT=         # Contact URI e.g. mailto:ops@barberbase.in

# Cloudflare R2 — pg_dump backups
# NOTE (2026-08-28): these are commented out in the live .env and no backup job
# exists on the droplet — no cron entry, no systemd timer, no script. See the M2
# report. 13_infra_env_deployment.md documents 6-hourly dumps as the strategy;
# it is not implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cloudflare R2 — MEDIA bucket (customer images).
# MUST be a separate bucket with its own scoped token: a credential that can
# write customer media must not also be able to read or delete database dumps.
# All optional — absent credentials disable image upload, never the queue.
R2_MEDIA_BUCKET_NAME=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_PUBLIC_BASE_URL=   # public read origin, e.g. https://cdn.barberbase.in

# Media caps (optional; defaults shown)
MEDIA_MAX_BYTES=            # 307200 (300KB) — headroom over the ~120KB client resize
MEDIA_MAX_PER_VARIANT=      # 6
MEDIA_REAP_BATCH=           # 100 rows per reaper tick

# Runtime
ENVIRONMENT=              # production | development
GOMEMLIMIT=               # 250MiB (also set in Docker Compose)
